@@ -1098,6 +1098,53 @@ class UnifiedTreeCore(UnifiedTreeCoreInterface):
                 self._build_backup_kv_action(state.target_node)
             )
 
+
+    def start_mamba_audit_heartbeat(self, interval: int = 300) -> None:
+        """Read-only audit heartbeat: DFS the tree every `interval` seconds and
+        log one MAMBA-AUDIT line (node/state counts, deepest state chain).
+        Added 2026-09-02 to pin down silent-period mamba state loss: the
+        snapshots bracket any disappearance to a single interval. Read-only,
+        touches no pool or LRU state."""
+        import threading
+        import logging
+        from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+
+        log = logging.getLogger(__name__)
+        ct = self.components_by_type and ComponentType.MAMBA
+        has_mamba = ComponentType.MAMBA in self.components_by_type
+
+        def _dfs(node, depth, acc):
+            acc["nodes"] += 1
+            if has_mamba:
+                cd = node.component_data[ComponentType.MAMBA]
+                if cd.value is not None:
+                    acc["states"] += 1
+                    acc["deepest"] = max(acc["deepest"], depth)
+            acc["branch_max"] = max(acc["branch_max"], len(node.children))
+            if node in self.evictable_device_leaves:
+                acc["evictable"] += 1
+            if any(getattr(cd, "lock_ref", 0) > 0 for cd in node.component_data):
+                acc["lock"] += 1
+            for ch in node.children.values():
+                _dfs(ch, depth + len(ch.key), acc)
+
+        def _loop():
+            while True:
+                try:
+                    acc = {"nodes": 0, "states": 0, "deepest": 0,
+                           "branch_max": 0, "evictable": 0, "lock": 0}
+                    _dfs(self.root_node, 0, acc)
+                    log.info(
+                        "MAMBA-AUDIT nodes=%d states=%d deepest=%d "
+                        "branch_max=%d evictable=%d locked=%d",
+                        acc["nodes"], acc["states"], acc["deepest"],
+                        acc["branch_max"], acc["evictable"], acc["lock"])
+                except Exception as e:
+                    log.info("MAMBA-AUDIT error=%s", e)
+                threading.Event().wait(interval)
+
+        threading.Thread(target=_loop, daemon=True, name="mamba-audit").start()
+
     def _split_node(
         self, key: RadixKey, child: UnifiedTreeNode, split_len: int
     ) -> tuple[UnifiedTreeNode, Optional[CacheAction | ComponentAction]]:
