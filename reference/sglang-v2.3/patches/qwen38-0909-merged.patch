+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.mem_cache.pool_host.mamba import MambaPoolHost
+
+
+def _make_host_and_device():
+    layers, slots = 2, 5
+    temporal_shape = (1, 4)
+    conv_shape = (1, 2)
+    temporal = torch.arange(layers * slots * 4, dtype=torch.float32).reshape(
+        layers, slots, *temporal_shape
+    )
+    conv = [
+        torch.arange(layers * slots * 2, dtype=torch.float32).reshape(
+            layers, slots, *conv_shape
+        )
+    ]
+    device_pool = SimpleNamespace(
+        mamba_cache=SimpleNamespace(temporal=temporal, conv=conv),
+        size=slots,
+        device="cpu",
+    )
+    host = MambaPoolHost.__new__(MambaPoolHost)
+    host.layout = "page_first"
+    host.page_size = 1
+    host.num_mamba_layers = layers
+    host.temporal_state_elem_size = 4
+    host.conv_state_shapes = [conv_shape]
+    host.conv_state_elem_sizes = [2]
+    host.conv_dtype = torch.float32
+    host.temporal_dtype = torch.float32
+    host.temporal_state_shape = temporal_shape
+    host.temporal_buffer = torch.zeros(
+        slots, layers, 1, *temporal_shape, dtype=torch.float32
+    )
+    host.conv_buffer = [
+        torch.zeros(slots, layers, 1, *conv_shape, dtype=torch.float32)
+    ]
+    host.temporal_staging_buffer = None
+    host.conv_staging_buffers = [None]
+    host._temporal_can_use_jit = False
+    host._conv_can_use_jit = [False]
+    host.temporal_device_ptrs = None
+    host.conv_device_ptrs = [None]
+    host.device_pool = device_pool
+    return host, device_pool
+
+
+def test_mamba_backup_uses_safe_copy_when_custom_kernel_is_unavailable():
+    host, device_pool = _make_host_and_device()
+    device_indices = torch.tensor([1, 4], dtype=torch.int64)
+    host_indices = torch.tensor([0, 2], dtype=torch.int64)
+
+    with patch(
+        "sglang.srt.mem_cache.pool_host.mamba.transfer_kv_mamba_lf_pf",
+        side_effect=AssertionError("custom Mamba kernel must not be used"),
+    ):
+        host.backup_from_device_all_layer(
+            device_pool, host_indices, device_indices, io_backend="kernel"
+        )
+
+    for layer_id in range(host.num_mamba_layers):
+        torch.testing.assert_close(
+            host.temporal_buffer[host_indices, layer_id, 0],
+            device_pool.mamba_cache.temporal[layer_id][device_indices],
+        )
+        torch.testing.assert_close(
+            host.conv_buffer[0][host_indices, layer_id, 0],
+            device_pool.mamba_cache.conv[0][layer_id][device_indices],
+        )
+
+
+def test_mamba_load_uses_safe_copy_when_custom_kernel_is_unavailable():
+    host, device_pool = _make_host_and_device()
+    device_indices = torch.tensor([1, 4], dtype=torch.int64)
+    host_indices = torch.tensor([0, 2], dtype=torch.int64)
+    host.backup_from_device_all_layer(
+        device_pool, host_indices, device_indices, io_backend="kernel"
+    )
+    for layer_id in range(host.num_mamba_layers):
