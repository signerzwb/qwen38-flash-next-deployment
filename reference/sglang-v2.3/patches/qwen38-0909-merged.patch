+
+
+def test_mamba_safe_copy_uses_direct_slices_without_gpu_gather_temp():
+    host, device_pool = _make_host_and_device()
+    source_narrow_calls = []
+    destination_narrow_calls = []
+
+    class NarrowOnlySource:
+        def __init__(self, tensor):
+            self.tensor = tensor
+            self.device = tensor.device
+            self.dtype = tensor.dtype
+            self.shape = tensor.shape
+
+        def index_select(self, dim, index):
+            raise AssertionError("safe copy must not allocate an index_select gather")
+
+        def __getitem__(self, index):
+            raise AssertionError("safe copy must not use strided row slicing")
+
+        def narrow(self, dim, start, length):
+            source_narrow_calls.append((dim, start, length))
+            return self.tensor.narrow(dim, start, length)
+
+    class NarrowOnlyDestination:
+        def __init__(self, tensor):
+            self.tensor = tensor
+
+        def __getitem__(self, index):
+            raise AssertionError("safe copy must not use strided row slicing")
+
+        def narrow(self, dim, start, length):
+            destination_narrow_calls.append((dim, start, length))
+            return self.tensor.narrow(dim, start, length)
+
+    src = NarrowOnlySource(device_pool.mamba_cache.temporal[0])
+    dst_tensor = host.temporal_buffer[:, 0, 0]
+    dst = NarrowOnlyDestination(dst_tensor)
+    src_indices = torch.tensor([4, 1, 3], dtype=torch.int64)
+    dst_indices = torch.tensor([0, 2, 4], dtype=torch.int64)
+
+    MambaPoolHost._safe_copy_device_to_host(src, dst, src_indices, dst_indices)
+
+    assert source_narrow_calls == [(0, 4, 1), (0, 1, 1), (0, 3, 1)]
+    assert destination_narrow_calls == [(0, 0, 1), (0, 2, 1), (0, 4, 1)]
+    torch.testing.assert_close(
+        dst_tensor[dst_indices], device_pool.mamba_cache.temporal[0][src_indices]
+    )
+
+
+def test_mamba_safe_copy_rejects_mismatched_empty_indices():
+    src = torch.zeros(2, 1, dtype=torch.float32)
+    dst = torch.zeros_like(src)
+    try:
+        MambaPoolHost._safe_copy_indexed_slices(
+            src,
+            dst,
