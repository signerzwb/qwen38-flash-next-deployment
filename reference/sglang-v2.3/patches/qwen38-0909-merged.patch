+    """Prepare Q/K/V for FlashInfer, materializing only strided inputs."""
+    if q.ndim != 3 or k.shape != q.shape or v.ndim != 3:
+        raise ValueError(
+            "GDN fused prepare requires equal Q/K [T, Hqk, D] shapes and "
+            "V [T, Hv, D], got "
