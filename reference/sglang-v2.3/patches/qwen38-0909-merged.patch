+        device_pool.mamba_cache.conv[0][layer_id].zero_()
+
+    with patch(
+        "sglang.srt.mem_cache.pool_host.mamba.transfer_kv_mamba_pf_lf",
+        side_effect=AssertionError("custom Mamba kernel must not be used"),
+    ):
+        for layer_id in range(host.num_mamba_layers):
+            host.load_to_device_per_layer(
